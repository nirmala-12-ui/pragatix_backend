{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/pragatix/access-logs/access_log*.log",
            "log_group_name": "/pragatix/backend/access",
            "log_stream_name": "access-{instance_id}",
            "retention_in_days": 365,
            "timezone": "Asia/Kolkata",
            "timestamp_format": "[%d/%b/%Y:%H:%M:%S %z]"
          }
        ]
      }
    }
  }
}